@using SharedModelsLib
@using Microsoft.AspNetCore.Components.Forms

<EditForm Model = "@filterModel" OnValidSubmit="FilterGroupes">
    <div class="card p-3">
        <h4>Chercher un groupe d'étude</h4>

        <div class="mb-3">
            <label class="form-label">Votre nom :</label>
            <InputText class="form-control" @bind-Value="filterModel.Nom"/>
        </div>

        <div class="mb-3">
            <label class="form-label">Cours :</label>
            <InputSelect class="form-select" @bind-Value="filterModel.CoursCode">
                <option value="">Choisir son cours</option>
                @foreach(var c in cours)
                {
                     <option value="@c.Code">@c.Code - @c.Nom</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Disponibilités :</label>
            <div class="table-responsive">
                <table class="table table-sm text-center align-middle">
                    <thead>
                        <tr>
                            <th></th>
                            @foreach (var jour in jours)
                            {
                                <th>@jour</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var heure in heures)
                        {
                            <tr>
                                <td>@(heure)h</td>
                                @foreach (var jour in jours)
                                {
                                    <td><input type="checkbox" @bind="disponibilites[(jour, heure)]" /></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Chercher</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public List<Cours> cours { get; set; } = new();

    private readonly string[] jours = { "Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi" };
    private readonly int[] heures = Enumerable.Range(8, 8).ToArray();
    public Dictionary<(string Jour, int Heure), bool> disponibilites { get; set; } = new();

    private FilterModel filterModel = new();

    [Inject]
    private NavigationManager Navigation { get; set; }

    protected override void OnInitialized()
    {
        foreach (var jour in jours)
        {
            foreach (var heure in heures)
            {
                disponibilites[(jour, heure)] = false;
            }
        }
    }

    public class FilterModel
    {
        public string Nom { get; set; } = "";
        public string CoursCode { get; set; } = "";
    }

    private void FilterGroupes()
    {
        Navigation.NavigateTo("/", forceLoad: true);
    }

}