@inject NavigationManager NavManager

@using SharedModelsLib.Dtos;


<div class="container mt-5">
    <h2>Groupes d'études</h2>

    <div class="table-responsive">
        <table class="table table-stiped table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Cours</th>
                    <th>Membres</th>
                    <th>Horaire</th>
                    <th>Local</th>
                </tr>
            </thead>
            
            <tbody>
                @foreach(var groupe in groupeEtude)
                {
                    <tr>
                        <td>@groupe.CoursCode</td> 
                        <td>@string.Join(", ",groupe.MembresNoms.Select(m => m))</td>
                        <td>@groupe.JourRetenu à @(groupe.HeureRetenu)h</td>
                        <td>@(groupe.LocalNom?.ToString() ?? "Aucun")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code{
    [Parameter]
    public List<GroupeEtudeDto> groupeEtude{ get; set; }
}

