@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using SharedModelsLib.Dtos
@using System.ComponentModel.DataAnnotations

<EditForm Model = "@filterModel" OnValidSubmit="MatchGroupes">
    <DataAnnotationsValidator />

    @if (erreurDisponibilite != null)
    {
        <p class="text-danger">@erreurDisponibilite</p>
    }

    <ValidationSummary />

    <div class="card p-3">
        <h4>Chercher un groupe d'étude</h4>

        <div class="mb-3">
            <label class="form-label">Votre nom :</label>
            <InputText class="form-control" @bind-Value="filterModel.Nom"/>
            <ValidationMessage For="@(() => filterModel.Nom)" class="text-danger" />
        </div>

        <div class="mb-3">
            <label class="form-label">Cours :</label>
            <InputSelect class="form-select" @bind-Value="filterModel.cId">
                <option value="">Choisir son cours</option>
                @foreach(var c in cours)
                {
                     <option value="@c.Id">@c.Code - @c.Nom</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => filterModel.cId)" class="text-danger" />
        </div>

        <div class="mb-3">
            <label class="form-label">Disponibilités :</label>
            <div class="table-responsive">
                <table class="table table-sm text-center align-middle">
                    <thead>
                        <tr>
                            <th></th>
                            @foreach (var jour in jours)
                            {
                                <th>@jour</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var heure in heures)
                        {
                            <tr>
                                <td>@(heure)h</td>
                                @foreach (var jour in jours)
                                {
                                    <td><input type="checkbox" @bind="disponibilites[(jour, heure)]" /></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Chercher</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public List<CoursDto> cours { get; set; } = new();

    private readonly string[] jours = { "Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi" };
    private readonly int[] heures = Enumerable.Range(8, 8).ToArray();
    private Dictionary<(string Jour, int Heure), bool> disponibilites = new();

    private FilterModel filterModel = new();
    private EtudiantDto etudiant = new();

    private string? erreurDisponibilite;

    [Inject]
    private NavigationManager Navigation { get; set; }

    protected override void OnInitialized()
    {
        foreach (var jour in jours)
        {
            foreach (var heure in heures)
            {
                disponibilites[(jour, heure)] = false;
            }
        }
    }

    public class FilterModel
    {
        [Required(ErrorMessage = "Entrez votre nom")]
        [StringLength(50, ErrorMessage = "50 caractères maximum")]
        [RegularExpression(@"^[\p{L} '\-]+$", ErrorMessage = "Le nom ne peut contenir que des lettres")]
        public string Nom { get; set; } = "";

        [Required(ErrorMessage = "Sélectionnez un cours")]
        public string cId { get; set; } = "";
    }

    private void MatchGroupes()
    {
        if(!disponibilites.Any(d => d.Value))
        {
            erreurDisponibilite = "Sélectionnez au moins une disponibilité";
            return;
        }
        erreurDisponibilite = null;

        etudiant.Nom = filterModel.Nom;
        var dispos = new List<DisponibiliteDto>();

        foreach(var jour in jours) //Boucle pour regarder chaque jours dans le dictionnaire
        {
            List<int> heuresSelected = new(); //Heures cochés

            foreach(var heure in heures) 
            {
                if(disponibilites[(jour, heure)])
                {
                    heuresSelected.Add(heure);
                }
            }

            if (heuresSelected.Count > 0)
            {
                DisponibiliteDto dispo = new();
                dispo.Jour = jour;
                dispo.CoursId = int.Parse(filterModel.cId);
                dispo.Heures = heuresSelected;
                //dispo.EtudiantId = 0; //Dont add!!!!!
                dispos.Add(dispo);
            }
        }

        string json = Uri.EscapeDataString(JsonSerializer.Serialize(etudiant));
        string json2 = Uri.EscapeDataString(JsonSerializer.Serialize(dispos));
        Navigation.NavigateTo($"/Home/AddEtudiant?etudiant={json}&disponibilites={json2}", forceLoad: true);
    }

}