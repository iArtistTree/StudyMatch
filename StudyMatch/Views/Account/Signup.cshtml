@using SharedModelsLib.Dtos;

@{
    ViewData["Title"] = "Signup";
}

<form method="post" asp-action="Signin" class="p-4 border rounded shadow-sm" style="max-width: 400px; margin: auto;">
    <div class="card p-3">
        <h4>Signup</h4>
        <div class="mb-3">
            <label class="form-label">Email :</label>
            <input name="email" type="email" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Mot de passe :</label>
            <input name="mdp" type="password" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Confirmer le mot de passe :</label>
            <input name="mdpc" type="password" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Signin</button>
        <br />
        <a asp-controller="Account" asp-action="Index" class="btn btn-outline-secondary mt-2">Login here</a>
    </div>


</form>
